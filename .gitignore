# 本文件用于声明 Git 忽略跟踪的文件和目录

# =========================
# Python 虚拟环境与缓存
# =========================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# =========================
# 前端依赖与构建产物
# =========================
frontend/node_modules/
frontend/dist/
*.local

# =========================
# IDE 与编辑器配置
# =========================
.vscode/
.idea/
*.swp
*.swo
*~

# =========================
# 操作系统生成文件
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# 环境变量与敏感信息
# =========================
.env
.env.local
.env.*.local

# =========================
# 测试与覆盖率
# =========================
.pytest_cache/
htmlcov/
.coverage
*.cover

# =========================
# 日志文件
# =========================
*.log
